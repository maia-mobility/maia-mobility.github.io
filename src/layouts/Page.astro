---
/*
 * 모든 페이지의 껍데기.
 *
 * **배경 도로가 여섯 페이지 전부에 깔린다.** 예전에는 홈에만 있었고, 나머지
 * 다섯 페이지는 그냥 어두운 배경 위의 문서였다 — 이 사이트의 전제가 배경인데
 * 그 전제가 여섯 중 다섯에서 사라져 있었던 셈이다. 도로는 문서 흐름 밖의
 * `position: fixed` 배경이라 본문 레이아웃에 관여하지 않는다.
 *
 * 홈은 예외다 — 홈의 첫 화면은 `index.astro` 가 직접 캔버스를 깔고 그 위에
 * 이름을 세운다(같은 캔버스를 두 번 깔지 않는다).
 *
 * 머리말 띠(옛 `Nav`)는 없앴다. 그 자리를 `CornerIndex` 한 줄이 대신한다.
 */
import Base from './Base.astro';
import CornerIndex from '../components/CornerIndex.astro';
import RoadCanvas from '../components/RoadCanvas';
import Footer from '../components/Footer';
import ScrollReveal from '../components/ScrollReveal.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: string;
  /** 홈처럼 페이지가 스스로 캔버스를 까는 경우 true — 여기서는 깔지 않는다. */
  ownsCanvas?: boolean;
}

const { lang, page, ownsCanvas = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<Base lang={lang} page={page}>
  {/* 내비바가 아니라 한 줄. 정적이라 JS 가 꺼져도 전부 동작한다. */}
  <CornerIndex slot="header" lang={lang} pathname={pathname} />
  {ownsCanvas ? null : <RoadCanvas client:load />}
  <slot />
  <Footer slot="footer" lang={lang} />
</Base>

<ScrollReveal />
