---
/*
 * 홈 (영문).
 *
 * 첫 화면부터 마지막 주소까지 **배경 도로 한 장 위**에 얹힌다. 캔버스는 여기서
 * 직접 깔고(`Page` 에는 `ownsCanvas` 로 알린다), 본문은 `HomeBody` 가 맡는다.
 */
import Page from '../layouts/Page.astro';
import RoadCanvas from '../components/RoadCanvas';
import HomeBody from '../sections/HomeBody.astro';
---

<Page lang="en" page="" ownsCanvas={true}>
  <RoadCanvas client:load />
  <HomeBody lang="en" />
</Page>
