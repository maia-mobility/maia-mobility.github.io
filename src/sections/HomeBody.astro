---
/*
 * 홈 본문 — 도로 옆.
 *
 * 전제: 페이지는 평범하게 아래로 흐르고, **연구실의 재료가 도로 옆에 선다.**
 *
 *   · **연구분야마다 그 분야의 시뮬레이션이 실제로 돈다.** 이름만 넷 나열하는
 *     화면이 아니다. 한 분야가 한 화면을 쓰고, 그 화면에서 배경 도로의 카메라도
 *     그 분야의 자리로 옮겨 간다(`data-act`) — 앞은 계측기, 뒤는 같은 장면의
 *     도로다. 같은 연구를 두 축척으로 동시에 본다.
 *   · **구역마다 뼈대가 다르다.** 눈썹줄 → 큰 제목 → 헤어라인 → 목록을 아홉 번
 *     반복한 것이 "AI 가 만든 티"의 실체였다. 여는 화면은 이름 하나, 연구는
 *     번호가 화면 밖으로 잘려 나가는 대칭 격자, 논문은 여백에 붙어 따라오는
 *     라벨, 사람은 점으로 해상되는 사진, 소식은 날짜 레일이다.
 *   · 화면 어디에도 가짜 계측값이 없다.
 *
 * **홈은 요약이다.** 논문·소식은 최근 것만 싣고 전체 목록은 각자의 페이지가
 * 맡는다. 연구분야만 예외로 넷 다 싣는다 — 시뮬레이션이 이 사이트의 본론이라서.
 *
 * 글은 전부 `src/data/*` 의 실제 문안이다. 지어낸 문장은 없고, 연구분야에는
 * 설명문을 두지 않는다(교수님 결정) — 키워드와 도는 모델이 설명을 대신한다.
 *
 * ── 조판 규율 ───────────────────────────────────────────────────────────
 *
 * 한 줄의 길이는 **글자 수로** 잡는다. `ch` 는 이 글꼴에서 평균 글자보다 30%
 * 쯤 넓어서(측정: 1ch = 10.3px, 평균 글자 7.8px @16.4px), `50ch` 가 실제로는
 * 약 66자다 — 가독 범위(45~75자) 한가운데다. 그래서 `--read: 50ch` 하나를
 * 본문 성격의 글에 공통으로 물린다.
 *
 * 줄이 **어디서** 바뀌는지도 값을 정한다. 소속·키워드처럼 의미 마디가 뚜렷한
 * 줄은 마디를 flex 항목으로 쪼개, 줄바꿈이 마디 사이에서만 일어나게 했다.
 * `white-space: nowrap` 으로 묶지 않은 이유는 320px 에서 마디 하나가 화면보다
 * 길어지면 그대로 가로 스크롤이 되기 때문이다 — 마디는 필요하면 스스로 접힌다.
 */
import TrafficSim from '../components/TrafficSim';
import DotPortrait from '../components/DotPortrait';
import { RESEARCH } from '../data/research';
import { PUBLICATIONS } from '../data/publications';
import { NEWS } from '../data/news';
import { SITE } from '../data/site';
import { PI } from '../data/people';
import { href, pick, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = (v: Parameters<typeof pick>[0]) => pick(v, lang);
const fmt = (iso: string) => iso.replaceAll('-', '.');

/**
 * 홈에 싣는 최근 논문. 종류를 섞어 연도 내림차순으로만 정렬한다 — 홈에서는
 * 저널/학술대회 구분보다 "최근에 무엇을 냈는가"가 먼저다. 구분은 논문 페이지의 몫.
 */
const RECENT_PUBS = [...PUBLICATIONS].sort((a, b) => b.year - a.year).slice(0, 5);
const RECENT_NEWS = NEWS.slice(0, 3);

/*
 * 소속은 쉼표가 곧 의미 마디다. 한 덩어리로 흘려 두면 좁은 화면에서
 * "Division / of Smart Infrastructure Engineering," 처럼 마디 한가운데가
 * 끊기고, 넓은 화면에서는 "Myongji University" 두 낱말만 다음 줄에 남았다.
 */
const AFFIL = t(SITE.affiliation).split(', ');

/*
 * 모집 문안은 두 문장이다. 앞 문장은 주장이고 뒷 문장은 "아래 메일로 연락하라"는
 * 안내다. 둘을 같은 크기로 세우면 이 페이지에서 가장 큰 글씨가 안내문이 된다.
 * 주장만 크게 세우고, 안내는 그것이 가리키는 주소 바로 위에 본문 크기로 둔다.
 * 문안 자체는 한 글자도 건드리지 않는다.
 */
const RECRUIT = t(SITE.recruiting).split(/(?<=[.\uff0e])\s+/);
const RECRUIT_CLAIM = RECRUIT.length > 1 ? RECRUIT.slice(0, -1).join(' ') : RECRUIT[0];
const RECRUIT_NOTE = RECRUIT.length > 1 ? RECRUIT[RECRUIT.length - 1] : '';
---

<main class="drive" id="main">
  {/* ① 여는 화면 — 이름이 가장 크다. 연구실 사이트에서 가장 먼저 읽혀야 하는 것. */}
  {/* `data-ink` 는 **캔버스에게 주는 표식**이다(`data-quiet` 와 같은 결). 이 글자들은
      스크롤을 내리면 점으로 풀려 배경 도로의 차체 점군에 자리 잡는다. 값은 어느
      차가 받는가다: `lane` = 우리 차로의 앞차 대열, `next` = 옆 차로.
      이름이 가장 크니 이름이 우리가 끝까지 따라가는 차들이 된다. */}
  <section class="open">
    {/* 이 상자는 **첫 화면에 붙어 있다**(sticky). 글자가 화면 위로 올라가다 점이
        되는 것이 아니라 **보이던 그 자리에서** 점이 되어야 하기 때문이다.
        `data-quiet="ink"` 는 그 자리의 도로를 낮추되, 글자가 점으로 바뀌는 만큼
        같이 풀리라는 표식이다 — 안 그러면 글자가 사라진 뒤로도 도로 왼쪽이
        계속 어둡다. */}
    <div class="openStick" data-quiet="ink">
      <h1 class="wordmark" data-ink="lane">{SITE.short}</h1>
      <p class="expand" data-ink="next">{t(SITE.expansion)}</p>
      <p class="claim" data-ink="next">{t(SITE.tagline)}</p>
      <p class="lede" data-ink="next">{t(SITE.hero)}</p>
      <p class="ann aff" data-ink="next">
        {AFFIL.map((part, i) => <span>{i < AFFIL.length - 1 ? `${part},` : part}</span>)}
      </p>
    </div>
  </section>

  {/* ② 연구 — 한 분야가 한 화면. 시뮬레이션이 돌고, 배경 도로도 그 분야로 간다. */}
  <section class="stage" id="research" data-road-stage>
    {RESEARCH.map((a, i) => (
      <article class="area" data-act={i} id={`area-${a.id}`}>
        <span class="ghost" aria-hidden="true">{a.index}</span>
        <div class="areaText" data-quiet>
          {/* 제목 위에 눈썹줄(`Research 01 / 04`)이 있었다. 제목 위의 작은 라벨은
              **이 사이트의 톤과 무관하게** AI 가 만든 화면의 첫 번째 표식이고,
              여기서는 알려 주는 것도 없었다 — 네 분야에는 순서가 없어서 번호가
              정보를 나르지 않고, 분야 이름은 혼자서 제 무게를 진다. 지웠다.
              화면 밖으로 잘려 나가는 큰 번호는 라벨이 아니라 구도라서 남긴다. */}
          <h2 class="areaName">{t(a.title)}</h2>
          <ul class="keys">
            {a.keywords.map((k) => <li>{k}</li>)}
          </ul>
        </div>
        <div class="areaSim">
          <TrafficSim client:visible scenario={a.scenario} lang={lang} compact />
        </div>
      </article>
    ))}
  </section>

  {/* ③ 논문 — 라벨이 여백에 붙어 목록을 끝까지 따라온다(sticky). */}
  <section class="papers" id="publications" data-quiet>
    <div class="margin">
      <h2 class="ann head">{t(UI.sectionPublications)}</h2>
      <p class="count">{PUBLICATIONS.length}</p>
      <a class="more" href={href('publications', lang)}>▸ {t(UI.seeAll)}</a>
    </div>
    <div class="rails">
      <ol class="rail">
        {RECENT_PUBS.map((p, i) => (
          <li class={i > 0 && RECENT_PUBS[i - 1]!.year === p.year ? 'same' : ''}>
            <span class="year">{p.year}</span>
            <div class="entry">
              <p class="eTitle">{p.title}</p>
              <p class="eVenue">{p.venue}{p.volume ? `, ${p.volume}` : ''}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ④ 사람 — 사진이 점으로 해상된다. 연구실에 사람이 없으면 연구실이 아니다. */}
  <section class="people" id="people" data-quiet>
    <DotPortrait src={PI.photo} alt={t(PI.name)} label="prof_yu" width={3} height={4} />
    <div class="bio">
      <h2 class="name">{t(PI.name)}</h2>
      <p class="lede">{t(PI.role)} · {SITE.short}</p>
      <ol class="cv">
        {PI.education.map((e) => (
          <li>
            <span class="period">{e.period}</span>
            <span class="org">{t(e.role)} — {t(e.org)}</span>
          </li>
        ))}
      </ol>
      <a class="more" href={href('people', lang)}>▸ {t(UI.seeAll)}</a>
    </div>
  </section>

  {/* ⑤ 소식 — 날짜 레일. */}
  <section class="news" id="news" data-quiet>
    <h2 class="ann head">{t(UI.sectionNews)}</h2>
    <ol class="feed">
      {RECENT_NEWS.map((n) => (
        <li>
          <span class="date">{fmt(n.date)}</span>
          <div class="item">
            <p class="nTitle">{t(n.title)}</p>
            {n.body ? <p class="nBody">{t(n.body)}</p> : null}
          </div>
        </li>
      ))}
    </ol>
    <a class="more" href={href('news', lang)}>▸ {t(UI.seeAll)}</a>
  </section>

  {/* ⑥ 함께하기 — 모집이 이 페이지에서 가장 큰 문장이어야 한다. */}
  <section class="join" id="join" data-quiet>
    <p class="claim">{RECRUIT_CLAIM}</p>
    <div class="reach">
      {RECRUIT_NOTE ? <p class="lede note">{RECRUIT_NOTE}</p> : null}
      <address class="where">
        {t(SITE.contact.address)}<br />
        <a class="mail" href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
        <span class="off"> · {SITE.contact.office}</span>
      </address>
    </div>
  </section>
</main>

<script>
  import { mountAllDotPortraits } from '../lib/dotPortrait';
  mountAllDotPortraits();
</script>

<style>
  /* ---- 공통 ----------------------------------------------------------- */
  /*
   * 읽는 글의 한 줄 길이. 이 글꼴에서 1ch ≒ 평균 글자의 1.3배라 50ch 가 약 66자다.
   * 크기가 다른 글에 같은 값을 물려도 **글자 수**가 같게 유지된다.
   */
  .drive { display: grid; --read: 50ch; }
  .ann {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono);
    color: var(--fg-mute);
  }
  .lede { margin: 0; max-inline-size: 44ch; font-size: var(--t-base); line-height: var(--lh-body); color: var(--fg-mute); }
  .mail { color: var(--fg); text-decoration: none; border-block-end: var(--hair) solid var(--line); }
  .mail:hover { border-block-end-color: var(--accent); }

  /* ---- ① 여는 화면 ---------------------------------------------------- */
  /*
   * 간격을 grid gap 하나로 주면 다섯 줄이 등간격으로 늘어서고, 무엇이 무엇에
   * 딸린 글인지가 사라진다. 확장명은 워드마크의 캡션이라 바짝 붙이고, 태그라인
   * 앞에서만 크게 쉰다 — 이 한 번의 숨이 여는 화면의 뼈대다.
   */
  /*
   * **글은 첫 화면 가운데에 그대로 있고, 그 아래로 여유가 붙는다.**
   *
   * 그 여유가 연출의 길이다. 배경의 `hp`(글자→차 진행도)는 연구 무대 상단의
   * 문서 좌표를 자로 쓰므로(usePointCloud §히어로 카피 퇴장 진행도), 여는 화면을
   * 늘린 만큼 글자가 점이 되어 차로 가는 데 쓰는 스크롤이 늘어난다. 100dvh 였을
   * 때는 전환이 175px 만에 끝나 "스크롤 한 번에 지나간다"였다.
   *
   * 여유는 빈 화면이 아니다 — 그 구간에서 점-글자가 풀려 날아가고, 도착한 뒤에는
   * 글자로 만들어진 차들이 실제로 달리는 것을 본다(도착 ≈485px, 무대 진입 ≈1,250px).
   *
   * 아래 여백을 늘리면서 `min-block-size` 를 같은 만큼 늘리므로 **콘텐츠 상자는
   * 그대로다** — 첫 화면의 글 위치가 1px 도 움직이지 않는다(hero:check 기준).
   */
  .open {
    /* 연출이 도는 동안 첫 화면이 붙어 있을 거리. 치환 250 + 풀어짐 100 + 조립
       500 = 866px 를 **세로가 짧은 창에서도** 덮어야 하므로 비율과 절대값 중 큰
       쪽을 쓴다(468px 창에서 110dvh 는 515px 뿐이다). 도착 뒤로 남는 구간에서는
       글자로 만들어진 차들이 달리는 것을 본다. */
    --open-run: max(110dvh, 60rem);
    min-block-size: calc(100dvh + var(--open-run));
    inline-size: min(46rem, 54%);
  }
  /* 콘텐츠 상자는 예전 `.open` 그대로다 — 첫 화면의 글이 1px 도 움직이지 않는다. */
  .openStick {
    position: sticky;
    inset-block-start: 0;
    block-size: 100dvh;
    display: grid;
    align-content: center;
    justify-items: start;
    padding: var(--space-9) var(--gutter);
  }
  /* 이름이 가장 크다. 연구실 사이트에서 가장 먼저 읽혀야 하는 것이라서. */
  .wordmark {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(4.5rem, 2rem + 11vw, 11rem);
    font-weight: var(--w-medium);
    line-height: 0.86;
    letter-spacing: -0.055em;
    color: var(--fg);
  }
  .expand { margin: var(--space-2) 0 0; font-family: var(--font-mono); font-size: var(--t-mono-sm); letter-spacing: var(--track-mono-read); color: var(--accent); }
  .open .claim { margin-block-start: var(--space-7); }
  .open .lede { margin-block-start: var(--space-3); }
  .claim {
    margin: 0;
    max-inline-size: 24ch;
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 1rem + 1.9vw, 2.6rem);
    font-weight: var(--w-light);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--fg);
  }
  /* 소속은 쉼표 마디로만 줄이 바뀐다. 넓으면 한 줄, 좁아지면 마디가 차례로
     내려앉아 주소처럼 쌓인다 — 마디 한가운데서 끊기는 일이 없다. */
  .aff {
    margin-block-start: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    /* 모노 한 칸(0.6em)에 트래킹(0.12em)을 더한 값 — 마디 사이가 낱말 사이와 같아진다. */
    gap: 0 0.72em;
  }

  /*
   * 글자가 점으로 풀려 나가는 동안 **DOM 글자는 꺼진다.** 켜지는 쪽은 캔버스다 —
   * 두 구간이 같은 자리·같은 진행도라야 "글자가 점으로 바뀌었다"로 읽힌다.
   * 그래서 구간을 여기서 정하지 않는다: 언제 풀릴지는 그 글자의 위끝이 화면
   * 위끝에 닿는 순간이 정하고(훅이 잰다), 훅이 `--ink-at`·`--ink-k` 로 알려 준다.
   *
   * **JS 가 없으면 변수도 없다.** 폴백은 전부 보이는 상태다 — 시작점 9 는
   * `--h` 가 영영 닿지 않는 값이라 opacity 가 1 로 굳는다.
   * `transition` 은 두지 않는다. 재생 헤드는 시간이 아니라 스크롤이다.
   */
  [data-ink] {
    opacity: calc(1 - clamp(0, (var(--h, 0) - var(--ink-at, 9)) * var(--ink-k, 1), 1));
  }

  /* ---- ② 연구 --------------------------------------------------------- */
  .area {
    position: relative;
    min-block-size: 100dvh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: center;
    align-items: center;
    gap: var(--space-7);
    padding-block: var(--space-8);
    overflow: clip; /* 화면 밖으로 잘리는 번호가 가로 스크롤을 만들지 않게 */
  }
  /* 번호는 **화면 밖으로 잘린다.** 읽으라고 둔 것이 아니라 자리를 세라고 둔 것이다.
     굵기를 한 단계 내린 이유: 이 위에 키워드 한 줄이 지나간다. */
  .ghost {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(var(--gutter) * -0.9);
    translate: 0 -50%;
    font-family: var(--font-sans);
    font-size: clamp(9rem, 4rem + 20vw, 22rem);
    font-weight: var(--w-light);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--line);
    pointer-events: none;
    user-select: none;
  }
  .areaText { position: relative; padding-inline-start: var(--gutter); display: grid; gap: var(--space-3); }
  /* 넷 중 몇 번째인지가 이 줄에서 유일하게 바뀌는 값이다 — 사이를 한 칸 더 띄워 따로 읽힌다. */
  .areaName {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.7rem, 1rem + 2.4vw, 3.1rem);
    font-weight: var(--w-light);
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--fg);
  }
  /* 키워드는 칩이 아니라 **줄바꿈되는 한 줄**이다 — 테두리를 넷씩 그리면 카드가 된다.
     설명문이 없는 구역이라 이 줄이 곧 본문이다. 그래서 광도를 한 단계 올렸다
     (잘려 나가는 번호 위를 지나가기도 한다). */
  .keys {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* 열 간격은 0 — 낱말 사이를 벌리는 일은 구분점이 자기 좌우 여백으로 한다.
       gap 과 '· ' 가 겹쳐 구분점이 허공에 떠 있던 것을 고쳤다. */
    gap: var(--space-1) 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
  }
  .keys li { white-space: nowrap; }
  /* 구분점은 **앞 낱말에 붙는다.** `li + li::before` 로 두면 줄이 바뀔 때 점이
     다음 줄 맨 앞에 떨어진다(02·04 막에서 실제로 그랬다). */
  .keys li:not(:last-child)::after {
    content: '·';
    padding-inline: 0.7em;
    color: var(--line-hot);
  }
  /* 계측기는 화면 끝까지 간다 — 여백에 얹은 카드가 아니라 도로에서 잘라 온 창이다. */
  .areaSim { min-inline-size: 0; }
  .area:nth-of-type(even) .areaSim { order: -1; }
  .area:nth-of-type(even) .areaText { padding-inline: 0 var(--gutter); }
  .area:nth-of-type(even) .ghost { inset-inline: auto calc(var(--gutter) * -0.9); }

  /* ---- ③ 논문 --------------------------------------------------------- */
  /*
   * 레일 폭이 곧 한 줄의 길이다. 58rem 이었을 때 제목 한 줄이 112자까지 갔다 —
   * 눈이 다음 줄 머리를 못 찾는다. 32rem 은 제목 최장 69자다.
   *
   * 30·32·34·36rem 을 재 봤다. 34rem 부터 최장 줄이 75자를 넘고, 30rem 은 줄 수가
   * 21 → 26 으로 는다. 32rem 은 줄 수는 34rem 과 같으면서 **마지막 줄이 짧게 남는
   * 제목이 없다**(최단 꼬리 29% · 34rem 은 21%). 점선 구분자가 열 끝까지 그어지므로
   * 이 폭은 곧 눈에 보이는 값이다.
   */
  .papers {
    display: grid;
    grid-template-columns: 12rem minmax(0, 32rem);
    gap: var(--space-6);
    padding: var(--section-y) var(--gutter);
  }
  /* 라벨이 목록을 끝까지 따라온다 — 스크롤해도 무엇을 읽는 중인지 안 놓친다.
     붙는 높이는 전역 `scroll-padding-block-start` 와 같은 값이어야 한다. */
  .margin { position: sticky; inset-block-start: var(--space-8); align-self: start; display: grid; gap: var(--space-2); }
  .head { color: var(--fg); }
  .count { margin: 0; font-family: var(--font-mono); font-size: var(--t-h3); line-height: 1; color: var(--line-hot); font-variant-numeric: tabular-nums; }
  .rails { display: grid; gap: var(--space-7); min-inline-size: 0; }
  .rail { list-style: none; margin: 0; padding: 0; display: grid; }
  /* 연도 칸은 rem 으로 잡는다 — `6ch` 는 상속받은 본문 크기를 따라 흔들렸다. */
  .rail li { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: var(--space-3); padding-block: var(--space-3); }
  .rail li + li { border-block-start: var(--hair) dotted var(--scan); }
  /* `.rail li` 가 특정성에서 이겨 이 패딩이 먹지 않았고, 그래서 레일 머리글이
     왼쪽 라벨보다 24px 내려가 있었다. 같은 특정성으로 올린다. */
  .rail li.railHead { padding-block: 0 var(--space-2); }
  .year { font-family: var(--font-mono); font-size: var(--t-mono-sm); color: var(--fg-mute); font-variant-numeric: tabular-nums; }
  .rail li.same .year { visibility: hidden; }
  .eTitle { margin: 0; font-size: var(--t-sm); line-height: var(--lh-2); letter-spacing: -0.008em; color: var(--fg); }
  .eVenue { margin: var(--space-05) 0 0; font-family: var(--font-mono); font-size: var(--t-micro); line-height: var(--lh-mono); color: var(--fg-mute); }

  /* ---- ④ 사람 --------------------------------------------------------- */
  /*
   * 사진 칸은 사진과 같은 폭(12rem ≒ DotPortrait 의 190px 상한)으로 줄였다.
   * 22rem 이었을 때 162px 이 빈 채로 남아 약력이 오른쪽으로 밀려 있었는데,
   * 12rem 으로 맞추면 약력의 왼쪽 모서리가 **논문 레일의 시작선과 겹친다.**
   */
  .people {
    display: grid;
    grid-template-columns: 12rem minmax(0, 46rem);
    align-items: start;
    gap: var(--space-6);
    padding: var(--section-y) var(--gutter);
  }
  .bio { display: grid; gap: var(--space-3); }
  .name { margin: 0; font-family: var(--font-sans); font-size: clamp(1.8rem, 1rem + 2.6vw, 3.2rem); font-weight: var(--w-light); line-height: 1; letter-spacing: -0.035em; color: var(--fg); }
  .cv { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: grid; gap: var(--space-2); }
  .cv li { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: var(--space-3); font-size: var(--t-sm); line-height: var(--lh-2); color: var(--fg-mute); }
  /* 세 줄이 모두 "… Civil and Environmental / Engineering" 으로 끝났다. */
  .org { text-wrap: pretty; }
  .period { font-family: var(--font-mono); font-size: var(--t-micro); line-height: var(--lh-2); color: var(--fg-dim); font-variant-numeric: tabular-nums; }

  /* ---- ⑤ 소식 --------------------------------------------------------- */
  .news { display: grid; gap: var(--space-5); padding: var(--section-y) var(--gutter); }
  .feed { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); max-inline-size: 46rem; }
  .feed li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: var(--space-3); }
  .date { font-family: var(--font-mono); font-size: var(--t-micro); line-height: var(--lh-2); color: var(--fg-mute); font-variant-numeric: tabular-nums; }
  .nTitle { margin: 0; max-inline-size: var(--read); font-size: var(--t-base); line-height: var(--lh-2); letter-spacing: -0.012em; color: var(--fg); }
  .nBody { margin: var(--space-2) 0 0; max-inline-size: var(--read); font-size: var(--t-sm); line-height: var(--lh-body); color: var(--fg-mute); }

  /* ---- ⑥ 함께하기 ----------------------------------------------------- */
  .join {
    min-block-size: 80dvh;
    display: grid;
    align-content: center;
    gap: var(--space-6);
    padding: var(--space-9) var(--gutter);
    inline-size: min(52rem, 62%);
    justify-self: end;
  }
  /* 26ch 에서는 네 줄이 되고 둘째 줄만 'graduate/undergraduate' 하나로 짧게 남았다.
     30ch 은 세 줄이고, 짧은 줄이 **첫 줄**로 간다 — 가운데가 파이지 않는다. */
  .join .claim { max-inline-size: 30ch; }
  /* 안내문과 주소는 한 덩어리다 — "아래의 메일"이 가리키는 것이 바로 아랫줄이다. */
  .reach { display: grid; gap: var(--space-3); }
  .where { font-style: normal; font-family: var(--font-mono); font-size: var(--t-micro); line-height: var(--lh-mono); letter-spacing: var(--track-mono-read); color: var(--fg-mute); }
  .where .off { color: var(--fg-dim); }

  /* ---- 좁은 화면 ------------------------------------------------------ */
  /*
   * 한 열로 접히면 **구역의 경계가 사라진다.** 넓은 화면에서는 두 칸 배치와
   * 여백에 붙은 라벨이 "여기서 다른 것이 시작한다"를 말했는데, 세로로 쌓고 나면
   * 남는 신호가 빈 띠 하나뿐이다. 그래서 구역 사이가 위아래 80px 씩 160px 로
   * 벌어져 있었고, 390px 에서 그 띠가 화면의 5분의 1이었다.
   *
   * 빈 띠를 키우는 대신 **점선 스캔 라인 한 줄**을 긋고 여백을 줄인다 —
   * 160px 의 허공이 하던 일을 1px 이 한다. 이 페이지의 논문 레일이 이미 같은
   * 점선을 쓰고 있어서, 새 어휘를 들여오는 것이 아니라 쓰던 것을 키운 것이다.
   */
  @media (max-width: 62rem) {
    .area,
    .papers,
    .people,
    .news,
    .join { border-block-start: var(--hair) dotted var(--scan); }
    /* 선은 **뒤에 오는 것에 붙는다** — 위가 좁고 아래가 넓어야 '끝'이 아니라
       '시작'으로 읽힌다. 경계 총합 160px → 104px. */
    .area,
    .papers,
    .people,
    .news { padding-block: var(--space-5) var(--space-7); }

    .area { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); min-block-size: auto; }
    .area .areaText, .area:nth-of-type(even) .areaText { padding-inline: var(--gutter); }
    /*
     * 계측기는 좁은 화면에서 **여백을 지킨다.** 넓은 화면에서 화면 끝까지 가는
     * 이유는 두 칸 중 바깥 칸이라 "도로에서 잘라 온 창"으로 읽히기 때문인데,
     * 한 열에서는 잘릴 변이 좌우 둘 다라 네 귀퉁이 틱이 전부 날아간다 —
     * 그러면 계측기가 아니라 그냥 캔버스다. 틱이 곧 이 상자의 정체다.
     */
    .area .areaSim, .area:nth-of-type(even) .areaSim { order: 0; padding-inline: var(--gutter); }
    /*
     * 잘려 나가는 번호는 **좁은 화면에서 지운다.**
     *
     * 그 장치는 좌우 변에서 잘려야 "한 화면에 담기지 않는 크기"로 읽힌다.
     * 한 열로 접히면 잘리는 변이 구역의 위끝뿐이라, 구역 사이 허공에 밑동만
     * 남은 글자가 뜬다(03·04 막에서 특히 파편으로 보였다). 하는 일 — 새 분야가
     * 여기서 시작한다 — 은 위의 스캔 라인과 `Research 01 / 04` 가 이미 한다.
     * 읽을 것은 `.ann` 에 그대로 있으므로 지워도 정보가 줄지 않는다.
     */
    .ghost { display: none; }

    .papers, .people { grid-template-columns: minmax(0, 1fr); }
    /* 라벨과 편수는 한 줄이다 — 세로로 쌓으면 목록 앞에 계단이 하나 더 생긴다.
       여백에 세워 두던 큰 숫자가 아니라 라벨에 딸린 계측값이 되므로, 크기를
       내리고 광도는 올린다(--line-hot 은 본문 크기에서 거의 안 보인다). */
    .margin { position: static; display: flex; align-items: baseline; gap: 0.9em; }
    .count { font-size: var(--t-h4); color: var(--fg-dim); }
    /*
     * 레일을 세로로 접는다. 390px 에서 연도·날짜 칸이 가로의 3분의 1을 먹어
     * 제목이 한 줄에 30자밖에 못 들어갔다 — 접으면 45자가 된다.
     * 연도가 반복되는 행은 자리까지 없앤다(넓은 화면에서는 자리만 비운다).
     * 학력도 같은 모양으로 접는다 — 기간 칸(6rem)이 96px 을 먹어 세 줄이 모두
     * "… Civil and / Environmental Engineering" 으로 두 줄이 되던 자리다.
     */
    .rail li, .feed li, .cv li { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
    .rail li.railHead .year, .rail li.same .year { display: none; }
    /* 행 상하 24px 은 11편에서 순수한 공백만 528px 이다. 행을 가르는 것은
       점선이지 공백이 아니므로 16px 로 내린다. */
    .rail li { padding-block: var(--space-2); }
    .cv { gap: var(--space-3); }
    .people { gap: var(--space-5); }

    /*
     * 여는 화면은 한 화면을 통째로 쓴다. `min-block-size: auto` 였을 때는
     * 556px 로 끝나 스크롤 첫 손짓에 이미 연구 구역이 들어와 있었고, 위로는
     * 고정된 색인에서 37px 밖에 안 떨어져 있었다 — 숨 쉴 자리가 없었다.
     * `svh` 를 쓰는 이유: 주소창이 보이는 상태의 높이라 어떤 경우에도 넘치지 않는다.
     */
    .open {
      /* 모바일은 구간이 0.7배(도착 611px)라 그만큼 짧게 잡는다. */
      --open-run: max(100svh, 46rem);
      inline-size: 100%;
      min-block-size: calc(100svh + var(--open-run));
    }
    .openStick {
      block-size: 100svh;
      padding-block: var(--space-9) var(--space-8);
    }
    /* 닫는 문장만 선 아래 여백이 한 칸 넓다(40 → 64px). 다른 구역은 선 바로 밑에
       10px 짜리 모노 라벨이 오지만 여기는 이 페이지에서 가장 큰 문장이 온다 —
       큰 글씨는 같은 간격에서 선에 더 붙어 보인다. 같은 값이 같은 여백은 아니다. */
    .join {
      inline-size: 100%;
      justify-self: stretch;
      min-block-size: auto;
      padding-block: var(--space-7) var(--space-9);
    }

    /* 모서리 색인을 본문 여백선에 맞춘다 — 24px 에 두면 MAIA 가 워드마크보다
       4px 밖으로 나가 두 개의 왼쪽 모서리가 생긴다. */
    /*
     * 터치에서는 글자 상자가 곧 과녁이 아니다 — 10px 모노 한 줄은 높이 15px 라
     * 44px 규격의 3분의 1이다. 레이아웃을 흔들지 않으려고 **자리를 차지하지 않는**
     * `::after` 로 과녁만 넓힌다(패딩으로 넓히면 baseline 정렬이 밀린다).
     */
  }
  @media (max-width: 34rem) {
    /*
     * 세로로 든 전화기에서는 항목 여섯이 한 줄에 안 들어간다. 390px 에서 한 줄에
     * 들어가기는 했는데 남는 폭이 0 이었고(실측 350 중 350), 320px 에서는 넘쳐서
     * `EN / KO` 한 덩어리만 왼쪽 아래로 떨어져 나가 미아가 됐다.
     *
     * 흐르는 대로 두지 않고 **두 줄로 짠다.** 윗줄은 이름과 언어 — 넓은 화면의
     * 양 끝 배치 그대로다. 아랫줄은 색인 넷. 그래서 링크는 전부 아랫줄에만 있고,
     * 위에서 넓힌 44px 과녁이 윗줄 항목과 겹칠 일이 없다.
     * (`order: 1` 로 색인을 언어 뒤로 보내고, `flex-basis: 100%` 로 한 줄을 통째로
     * 차지하게 해 항상 같은 자리에서 접히게 한다.)
     */
  }
  /* 전체 목록으로 가는 링크 — 홈의 구역은 요약이라 나가는 문이 하나씩 필요하다. */
  .more {
    justify-self: start;
    margin-block-start: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-mono);
    color: var(--fg-mute);
    text-decoration: none;
    border-block-end: var(--hair) solid transparent;
    transition: color 160ms linear, border-color 160ms linear;
  }
  .more:hover,
  .more:focus-visible {
    color: var(--fg);
    border-block-end-color: var(--accent);
  }
  .papers .more { margin-block-start: var(--space-3); }
</style>
