---
/*
 * 강의 — 학기 적재 목록(manifest).
 *
 * 이 페이지는 데이터가 가장 적다(한 학기 · 세 과목).
 *
 *   · 학기가 이 페이지의 가장 큰 글이다. 과목 제목이 아니라 **언제**가 먼저다 —
 *     강의 목록은 시간표이고, 학기가 바뀌면 목록이 통째로 바뀐다.
 *   · 학기 아래는 **수준별 묶음**이다. `UNDERGRADUATE ·········` 한 줄이 그
 *     묶음을 열고, 과목이 그 아래로 내려간다 — 논문 페이지의 종류 스트립과
 *     같은 어휘다.
 *
 * 행마다 왼쪽 기둥에 `UNDERGRADUATE` 가 서 있었다. 세 행의 값이 전부 같으니
 * 그 칸은 정보를 나르지 않고 가로만 먹었다(같은 낱말이 세 번). 묶음의 머리로
 * 한 번만 세우면, 대학원 과목이 생기는 날 묶음이 저절로 둘이 된다.
 * 학기 옆의 과목 수(`03`)도 지웠다 — 세 줄짜리 목록이 스스로 세어 준다.
 *
 * 글은 전부 `src/data/teaching.ts` 의 것이다.
 */
import { byTerm, type Course, type Level } from '../data/teaching';
import { pick, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = (v: Parameters<typeof pick>[0]) => pick(v, lang);

const TERMS = byTerm();

/** 수준 라벨. 묶음의 머리로 한 번만 선다. */
const LEVEL_LABEL = { undergraduate: UI.undergraduate, graduate: UI.graduate };

/** 한 학기를 수준별로 나눈다. 빈 묶음은 머리를 세우지 않는다. */
const LEVELS: Level[] = ['undergraduate', 'graduate'];
const byLevel = (courses: Course[]) =>
  LEVELS.map((level) => ({ level, courses: courses.filter((c) => c.level === level) })).filter(
    (g) => g.courses.length > 0
  );
---

<div class="page">
  <header class="lead" data-quiet>
    <h1 class="title">{t(UI.sectionTeaching)}</h1>
  </header>

  {
    TERMS.map((g) => (
      <section class="term" data-quiet>
        <h2 class="termName">{t(g.term)}</h2>

        {byLevel(g.courses).map((lv) => (
          <div class="lvl">
            <h3 class="strip">
              <span class="stripLabel">{t(LEVEL_LABEL[lv.level])}</span>
              <span class="rule" aria-hidden="true" />
            </h3>

            <ol class="manifest">
              {lv.courses.map((c) => (
                <li>
                  <p class="cTitle">{t(c.title)}</p>
                  <p class="cMeta">
                    <span>{t(c.program)}</span>
                    {c.note ? <span class="note">{t(c.note)}</span> : null}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))
  }
</div>

<style>
  .page {
    display: grid;
    inline-size: min(100%, 62rem);
    padding-inline: var(--gutter);
    padding-block-end: var(--space-9);
  }

  /* ---- 머리 ----------------------------------------------------------- */
  /* 제목만. 아래의 학기가 곧 이 페이지의 디스플레이라 여기서는 크기를 낮춘다. */
  .lead {
    padding-block: var(--space-9) var(--space-8);
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4rem);
    font-weight: var(--w-thin);
    line-height: 0.94;
    letter-spacing: -0.042em;
    color: var(--fg);
  }

  /* ---- 학기 ----------------------------------------------------------- */
  .term {
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-8);
  }
  .termName {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.6rem, 1rem + 2.2vw, 2.8rem);
    font-weight: var(--w-light);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--fg);
  }
  /* ---- 수준 묶음 ------------------------------------------------------- */
  .lvl {
    display: grid;
    gap: var(--space-2);
  }
  .lvl + .lvl {
    margin-block-start: var(--space-5);
  }
  /*
   * 라벨 → 점선. 논문 페이지의 종류 스트립과 같은 줄이다. 선을 글자 뒤에서
   * 시작하므로 라벨 뒤에 깔 불투명 면이 필요 없다(면을 깔면 도로가 잘린다).
   */
  .strip {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: var(--w-mono);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  /*
   * 모노 계측 라벨 안의 한글. 모노 글꼴에는 한글이 없어 본문 글꼴로 떨어지는데,
   * 라틴 대문자용으로 잡은 넓은 트래킹(0.18em)이 그대로 걸리면 글자가 흩어진다
   * (`학부` 가 `학 부` 로 읽혔다). global.css 의 `.mono:lang(ko)` 와 같은 값으로.
   */
  .strip:lang(ko) {
    letter-spacing: 0.04em;
  }
  .rule {
    flex: 1 1 auto;
    min-inline-size: 2rem;
    block-size: 0;
    border-block-start: var(--hair) dotted var(--scan);
  }

  /* ---- 적재 목록 ------------------------------------------------------- */
  .manifest {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .manifest li {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
    padding-block: var(--space-3);
  }
  .manifest li + li {
    border-block-start: var(--hair) dotted var(--scan);
  }

  .cTitle {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--t-lg);
    font-weight: var(--w-regular);
    line-height: var(--lh-2);
    letter-spacing: -0.015em;
    color: var(--fg);
    text-wrap: pretty;
  }
  /*
   * 소속과 비고는 의미 마디가 뚜렷한 줄이다 — 마디를 flex 항목으로 쪼개
   * 줄바꿈이 마디 **사이**에서만 일어나게 한다. `nowrap` 으로 묶지 않는 이유는
   * 320px 에서 마디 하나가 화면보다 길면 그대로 가로 스크롤이 되기 때문이다.
   */
  .cMeta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.7em;
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--fg-mute);
  }
  .note::before {
    content: '·';
    margin-inline-end: 0.7em;
    color: var(--line-hot);
  }

  /* ---- 좁은 화면 ------------------------------------------------------ */
  @media (max-width: 48rem) {
    .lead {
      /* 위쪽 120px — 고정 색인이 좁은 화면에서 두세 줄로 접히면 바닥이 100px 까지 내려온다. 80px 이면 제목 위에 얹혔다(실측). */
      padding-block: var(--space-9) var(--space-6);
    }
    .manifest li {
      padding-block: var(--space-2);
    }
    .term {
      gap: var(--space-3);
      padding-block-end: var(--space-7);
    }
  }
</style>
