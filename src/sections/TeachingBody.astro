---
/*
 * 강의 — 학기 적재 목록(manifest).
 *
 * 이 페이지는 데이터가 가장 적다(한 학기 · 세 과목). 목록을 촘촘한 로그 행으로
 * 짜면 화면의 10분의 1만 쓰고 끝나서, **번호를 크게 키워 자리를 벌었다.**
 *
 *   · `01 02 03` 은 디스플레이 크기의 sans 다. 홈에서 화면 밖으로 잘려 나가던
 *     그 번호를 여기서는 **흐름 안에 세운다** — 자를 변이 없는 페이지라 잘라 봐야
 *     파편만 남는다. 번호가 행의 왼쪽 기둥이 되어 목록에 리듬을 준다.
 *   · 학기가 이 페이지의 가장 큰 글이다. 과목 제목이 아니라 **언제**가 먼저다 —
 *     강의 목록은 시간표이고, 학기가 바뀌면 목록이 통째로 바뀐다.
 *   · 학부/대학원 구분은 오른쪽 여백에 모노로 선다. 테두리 친 칩으로 만들면
 *     세 줄에 작은 카드가 셋 생긴다.
 *
 * 글은 전부 `src/data/teaching.ts` 의 것이다.
 */
import { byTerm } from '../data/teaching';
import { pick, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = (v: Parameters<typeof pick>[0]) => pick(v, lang);
const nn = (n: number) => String(n).padStart(2, '0');

const TERMS = byTerm();
---

<div class="page">
  <header class="lead" data-quiet>
    <h1 class="title">{t(UI.sectionTeaching)}</h1>
  </header>

  {
    TERMS.map((g) => (
      <section class="term" data-quiet>
        <div class="termHead">
          <h2 class="termName">{t(g.term)}</h2>
          <p class="ann termCount">
            <span class="rule" aria-hidden="true" />
            {nn(g.courses.length)}
          </p>
        </div>

        <ol class="manifest">
          {g.courses.map((c, i) => (
            <li>
              <span class="no" aria-hidden="true">
                {nn(i + 1)}
              </span>

              <div class="entry">
                <h3 class="cTitle">{t(c.title)}</h3>
                <p class="cMeta">
                  <span>{t(c.program)}</span>
                  {c.note ? <span class="note">{t(c.note)}</span> : null}
                </p>
              </div>

              <span class="level">
                {t(c.level === 'graduate' ? UI.graduate : UI.undergraduate)}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .page {
    display: grid;
    inline-size: min(100%, 62rem);
    padding-inline: var(--gutter);
    padding-block-end: var(--space-9);
  }

  .ann {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono);
    color: var(--fg-mute);
  }

  /* ---- 머리 ----------------------------------------------------------- */
  /* 제목만. 아래의 학기가 곧 이 페이지의 디스플레이라 여기서는 크기를 낮춘다. */
  .lead {
    padding-block: var(--space-9) var(--space-8);
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4rem);
    font-weight: var(--w-thin);
    line-height: 0.94;
    letter-spacing: -0.042em;
    color: var(--fg);
  }

  /* ---- 학기 ----------------------------------------------------------- */
  .term {
    display: grid;
    gap: var(--space-5);
    padding-block-end: var(--space-8);
  }
  .termHead {
    display: grid;
    gap: var(--space-2);
  }
  .termName {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.6rem, 1rem + 2.2vw, 2.8rem);
    font-weight: var(--w-light);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--fg);
  }
  /* 과목 수는 학기의 계측값이다 — 점선이 왼쪽에서 달려와 숫자에서 멈춘다. */
  .termCount {
    display: flex;
    align-items: center;
    gap: 0.7em;
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
  }
  .rule {
    flex: 1 1 auto;
    min-inline-size: 2rem;
    block-size: 0;
    border-block-start: var(--hair) dotted var(--scan);
  }

  /* ---- 적재 목록 ------------------------------------------------------- */
  .manifest {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .manifest li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .manifest li + li {
    border-block-start: var(--hair) dotted var(--scan);
  }

  /*
   * 번호. 홈의 잘려 나가는 번호와 같은 어휘지만 여기서는 흐름 안에 선다 —
   * 굵기를 가장 얇게, 광도는 헤어라인 한 단계 위로. 읽으라고 둔 것이 아니라
   * 행의 무게를 잡으라고 둔 것이다.
   */
  .no {
    font-family: var(--font-sans);
    font-size: clamp(1.8rem, 1.1rem + 2.4vw, 3rem);
    font-weight: var(--w-thin);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--line-hot);
    font-variant-numeric: tabular-nums;
    user-select: none;
  }

  .entry {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }
  .cTitle {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--t-lg);
    font-weight: var(--w-regular);
    line-height: var(--lh-2);
    letter-spacing: -0.015em;
    color: var(--fg);
    text-wrap: pretty;
  }
  /*
   * 소속과 비고는 의미 마디가 뚜렷한 줄이다 — 마디를 flex 항목으로 쪼개
   * 줄바꿈이 마디 **사이**에서만 일어나게 한다. `nowrap` 으로 묶지 않는 이유는
   * 320px 에서 마디 하나가 화면보다 길면 그대로 가로 스크롤이 되기 때문이다.
   */
  .cMeta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.7em;
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--fg-mute);
  }
  .note::before {
    content: '·';
    margin-inline-end: 0.7em;
    color: var(--line-hot);
  }

  /* 학부/대학원 — 오른쪽 여백의 모노 표기. 칩이 아니다. */
  .level {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--fg-mute);
    white-space: nowrap;
  }
  /*
   * 모노 계측 라벨 안의 한글. 모노 글꼴에는 한글이 없어 본문 글꼴로 떨어지는데,
   * 라틴 대문자용으로 잡은 넓은 트래킹(0.18em)이 그대로 걸리면 글자가 흩어진다
   * (`학부` 가 `학 부` 로 읽혔다). global.css 의
   * `.mono:lang(ko)` 와 같은 값으로 되돌린다.
   */
  .level:lang(ko) {
    letter-spacing: 0.04em;
  }

  /* ---- 좁은 화면 ------------------------------------------------------ */
  @media (max-width: 48rem) {
    .lead {
      padding-block: var(--space-8) var(--space-6);
    }
    /*
     * 세 칸을 두 칸으로 줄인다 — 번호 칸은 남기고(행의 뼈대다) 구분 표기만
     * 본문 아래로 내린다. 390px 에서 세 칸이면 제목이 한 줄에 22자였다.
     */
    .manifest li {
      grid-template-columns: 3rem minmax(0, 1fr);
      /* 행 간격은 좁게 — 구분 표기는 본문에 딸린 꼬리표이지 다음 덩이가 아니다. */
      gap: var(--space-1) var(--space-3);
      padding-block: var(--space-3);
    }
    .level {
      grid-column: 2;
      justify-self: start;
    }
    .term {
      gap: var(--space-4);
      padding-block-end: var(--space-7);
    }
  }
</style>
