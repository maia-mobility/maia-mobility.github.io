---
/*
 * 소식 — 연도 묶음과 기사.
 *
 * 홈의 소식 구역은 날짜 레일 옆에 제목이 본문 크기로 붙는 **목록**이다. 여기는
 * 전체 소식이라 목록이 아니라 **기사**로 읽혀야 한다:
 *
 *   · 연도가 왼쪽 열의 머리에 큰 숫자로 서고, **그 아래로 월·일이 열을 이룬다**
 *     (`08.25`). 소식이 쌓이면 이 열이 페이지의 눈금이 된다.
 *   · 제목이 그 옆에 선다. 소식은 제목이 곧 내용이라, 본문 크기로 눕히면 목록
 *     한 줄과 구분되지 않는다.
 *
 * 제목 위에 `08.25  GRANT` 한 줄이 눈썹줄로 얹혀 있었다. 날짜는 정보라 왼쪽
 * 열로 내려보냈고 — 거기서는 여러 기사의 날짜가 세로로 줄을 서서 **언제**가
 * 한눈에 읽힌다 — 분류(`GRANT`·`LAB`)는 지웠다. 소식 두 건에 분류가 둘이면
 * 그 라벨은 나누는 일을 하지 않는다. 제목 옆의 건수(`02`)도 같은 이유로 지웠다.
 *
 * 연도는 붙어 따라오지 않는다(sticky 아님). 이제 그 열에 날짜가 서 있어서,
 * 따라오는 숫자가 날짜 위를 지나가기 때문이다.
 *
 * 글은 전부 `src/data/news.ts` 의 것이다.
 */
import DotPortrait from '../components/DotPortrait';
import { GALLERY } from '../data/gallery';
import { NEWS } from '../data/news';
import { pick, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = (v: Parameters<typeof pick>[0]) => pick(v, lang);

/** ISO `2026-08-25` → `08.25`. 연도는 묶음의 큰 숫자가 이미 말한다. */
const monthDay = (iso: string) => iso.slice(5).replace('-', '.');

/** 최신순 묶음. `NEWS` 는 이미 최신순이라 순서를 그대로 쓴다. */
const YEARS = NEWS.reduce<{ year: string; items: typeof NEWS }[]>((acc, n) => {
  const year = n.date.slice(0, 4);
  const last = acc[acc.length - 1];
  if (last && last.year === year) last.items.push(n);
  else acc.push({ year, items: [n] });
  return acc;
}, []);
---

<div class="page">
  <header class="lead" data-quiet>
    <h1 class="title">{t(UI.sectionNews)}</h1>
  </header>

  {
    YEARS.map((g) => (
      <section class="year" data-quiet>
        <p class="yearMark">{g.year}</p>

        <ol class="feed">
          {g.items.map((n) => (
            <li>
              <time class="when" datetime={n.date}>
                {monthDay(n.date)}
              </time>

              <div class="entry">
                <h2 class="nTitle">{t(n.title)}</h2>
                {n.body ? <p class="nBody">{t(n.body)}</p> : null}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  {
    GALLERY.map((ev) => (
      <section class="gallery" data-quiet data-pager>
        <header class="gHead">
          <h2 class="gTitle">{t(ev.title)}</h2>
          <div class="gNav">
            <span class="gCount" data-pager-count aria-live="polite">
              01 / {String(ev.photos.length).padStart(2, '0')}
            </span>
            <button type="button" class="ctrl" data-pager-prev aria-label={String(t(UI.prevPhoto))}>
              <span aria-hidden="true">◂</span>
            </button>
            <button type="button" class="ctrl" data-pager-next aria-label={String(t(UI.nextPhoto))}>
              <span aria-hidden="true">▸</span>
            </button>
          </div>
        </header>

        <ul class="track" data-pager-track tabindex="0" aria-label={String(t(ev.title))}>
          {ev.photos.map((p) => (
            <li class="slide" style={`--r:${p.width / p.height}`}>
              <figure>
                <DotPortrait
                  src={p.src}
                  alt={t(p.alt)}
                  label={p.id}
                  width={p.width}
                  height={p.height}
                  duration={1}
                />
                <figcaption class="cap">{t(p.caption)}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<script>
  import { mountAllDotPortraits } from '../lib/dotPortrait';
  mountAllDotPortraits();

  /* 가로 페이저 — 스크롤 스냅이 일을 하고, 여기서는 쪽수 표기와 버튼만 맡는다. */
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-pager]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-pager-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const count = root.querySelector<HTMLElement>('[data-pager-count]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-pager-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-pager-next]')!;
    const pad = (n: number) => String(n).padStart(2, '0');

    /* 트랙 왼쪽 가장자리에 가장 가까운 슬라이드 */
    const current = () => {
      const x = track.scrollLeft;
      /* 끝까지 밀리면 마지막 장 — 마지막 슬라이드는 왼쪽 선에 못 닿고 멈춘다. */
      if (x + track.clientWidth >= track.scrollWidth - 2) return slides.length - 1;
      let best = 0;
      slides.forEach((s, i) => {
        if (Math.abs(s.offsetLeft - track.offsetLeft - x) < Math.abs(slides[best].offsetLeft - track.offsetLeft - x)) best = i;
      });
      return best;
    };
    const sync = () => {
      const i = current();
      count.textContent = `${pad(i + 1)} / ${pad(slides.length)}`;
      prev.disabled = i === 0;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    const go = (d: number) => {
      const i = Math.min(slides.length - 1, Math.max(0, current() + d));
      track.scrollTo({
        left: slides[i].offsetLeft - track.offsetLeft,
        behavior: reduced ? 'auto' : 'smooth',
      });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', sync, { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
    });
    addEventListener('resize', sync);
    sync();
  });
</script>

<style>
  .page {
    display: grid;
    inline-size: min(100%, 64rem);
    padding-inline: var(--gutter);
    padding-block-end: var(--space-9);
  }

  /* ---- 머리 ----------------------------------------------------------- */
  .lead {
    padding-block: var(--space-9) var(--space-8);
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4rem);
    font-weight: var(--w-thin);
    line-height: 0.94;
    letter-spacing: -0.042em;
    color: var(--fg);
  }
  /* ---- 연도 묶음 ------------------------------------------------------- */
  .year {
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-8);
  }

  /* 연도는 날짜 열의 머리다 — 같은 왼쪽 기준선에서 시작해 아래로 월·일이 선다. */
  .yearMark {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.2rem);
    font-weight: var(--w-thin);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
  }

  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    min-inline-size: 0;
  }
  /* 날짜가 왼쪽 열에 서고 기사가 그 옆으로 흐른다 — 논문의 연도 레일과 같은 행. */
  .feed li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
  }
  .feed li:first-child {
    padding-block-start: 0;
  }
  .feed li + li {
    border-block-start: var(--hair) dotted var(--scan);
  }
  .when {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: var(--lh-2);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
    font-variant-numeric: tabular-nums;
  }
  .entry {
    display: grid;
    min-inline-size: 0;
  }

  /*
   * 제목은 기사의 머리이지 이 페이지의 디스플레이가 아니다. 32px 까지 키웠더니
   * 공지 한 줄이 아니라 슬로건으로 읽혔다 — 한 단 내리고, 본문과의 단 차이는
   * 크기와 광도 양쪽으로 그대로 둔다.
   */
  .nTitle {
    margin: 0;
    max-inline-size: 46ch;
    font-family: var(--font-sans);
    font-size: var(--t-lg);
    font-weight: var(--w-regular);
    line-height: var(--lh-2);
    letter-spacing: -0.015em;
    color: var(--fg);
    text-wrap: pretty;
  }
  .nBody {
    margin: var(--space-1) 0 0;
    max-inline-size: 50ch;
    font-size: var(--t-base);
    line-height: var(--lh-body);
    color: var(--fg-mute);
    text-wrap: pretty;
  }

  /* ---- 현장 사진 -------------------------------------------------------
     가로로 넘기는 페이저(iOS 의 페이지 전환처럼 한 장씩 스냅). 사진은 구성원
     사진과 같은 어휘(점으로 해상 + 코너 틱)다. 다음 장이 오른쪽에 살짝 보여
     넘길 수 있다는 것이 읽힌다. 구분은 점선 스캔 라인. */
  .gallery {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-8);
    border-block-start: var(--hair) dotted var(--scan);
  }
  .gHead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .gTitle {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--t-lg);
    font-weight: var(--w-regular);
    line-height: var(--lh-2);
    letter-spacing: -0.015em;
    color: var(--fg);
  }
  .gNav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .gCount {
    margin-inline-end: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
    font-variant-numeric: tabular-nums;
  }
  /* 버튼 어휘 — 사각 1px, 모노, hover 에서 테두리가 점등. */
  .ctrl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tap-min);
    min-inline-size: var(--tap-min);
    background: transparent;
    border: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--fg-mute);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .ctrl:hover:not(:disabled),
  .ctrl:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .ctrl:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .track {
    --h: clamp(18rem, 62vh, 32rem);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: var(--hair) solid var(--accent);
    outline-offset: 4px;
  }
  .slide {
    flex: 0 0 auto;
    /* 높이를 맞추고 폭은 사진 비율이 정한다. 좁은 화면에서는 화면 폭 안에서 다음 장이 비친다. */
    inline-size: min(calc(var(--h) * var(--r)), 82vw);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .slide figure {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  /* DotPortrait 의 190px 상한을 이 구역에서만 푼다(People 의 .portrait 와 같은 방식). */
  .slide :global([data-dot-wrap]) {
    max-inline-size: 100%;
  }
  .cap {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
  }

  /* ---- 좁은 화면 ------------------------------------------------------ */
  @media (max-width: 48rem) {
    .lead {
      /* 위쪽 120px — 고정 색인이 좁은 화면에서 두세 줄로 접히면 바닥이 100px 까지 내려온다. 80px 이면 제목 위에 얹혔다(실측). */
      padding-block: var(--space-9) var(--space-5);
    }
    /*
     * 날짜 칸(144px)이 390px 에서 가로의 절반 가까이를 먹는다 — 행을 세로로
     * 접어 날짜를 제목 위에 올린다(논문 레일과 같은 규칙).
     */
    .year {
      gap: var(--space-3);
      padding-block-end: var(--space-7);
    }
    .yearMark {
      font-size: var(--t-h4);
    }
    .feed li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
      padding-block: var(--space-4);
    }
  }
</style>
