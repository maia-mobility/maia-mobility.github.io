---
/*
 * 구성원 — 한 사람의 조서(dossier).
 *
 * 홈의 사람 구역은 이름 · 직함 · 학력 세 줄짜리 **요약**이다. 여기는 경력까지
 * 펼친 본론이라, 글이 한 화면보다 길다. 그래서 뼈대를 이렇게 잡았다:
 *
 *   · **사진이 왼쪽 여백에 붙어 따라온다**(sticky). 조서를 어디까지 읽든
 *     "누구의 기록인가"가 화면에 남는다.
 *   · 오른쪽은 **한 줄기 흐름**이다 — 이름 → 직함 → 소속 → 부임·메일 →
 *     학력 레일 → 경력 레일. 학력·경력은 기간이 왼쪽에 서는 같은 레일이라
 *     두 이력을 눈으로 겹쳐 볼 수 있다.
 *   · 마지막은 **빈 명단**이다. 연구실은 2026년 3월에 문을 열었고 구성원이 아직
 *     없다. 그 자리에 모집 문안을 둔다 — 빈 칸을 감추지 않는 것이 신생 연구실의
 *     사실이다.
 *
 * 왼쪽 레일에 로마자 표기(`Yu, H.`)와 `2026.03~` 가 사진 밑에 붙어 있었다.
 * 인용 표기는 이름표가 아니고(그 이름은 논문 페이지에서 저자로 만난다),
 * 물결표 하나짜리 기간은 뜻이 읽히지 않는 암호였다. 표기는 지우고 기간은
 * 뜻이 서는 한 줄(`Since 2026.03`)로 흐름에 옮겼다. 메일도 같이 옮겼다 —
 * 연락처는 사진이 아니라 **이름 옆**에 있어야 하고, 그래야 좁은 화면에서
 * 사진 다음에 오는 것이 이름이 된다.
 *
 * 카드(HudFrame)를 쓰지 않는다. 이 페이지의 글은 도로 위에 그대로 앉고,
 * 가독성은 `data-quiet` 가 점군을 성기게 만들어 낸다(판 금지).
 *
 * 사진의 dot 해상은 React 없이 `src/lib/dotPortrait.ts` 가 구동한다 — 이 페이지의
 * 유일한 인터랙션이라 런타임을 실을 이유가 없다.
 */
import DotPortrait from '../components/DotPortrait';
import { PI, MEMBERS, ALUMNI } from '../data/people';
import { SITE } from '../data/site';
import { pick, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = (v: Parameters<typeof pick>[0]) => pick(v, lang);

/**
 * `2026.03~` → `Since 2026.03` / `2026.03 부임`.
 * 데이터의 물결표를 떼고 낱말을 붙인다 — 붙는 자리가 언어마다 다르다.
 */
const START = PI.since?.replace(/[~\u2013\u2014-]+$/, '') ?? '';
const SINCE = lang === 'en' ? `${t(UI.since)} ${START}` : `${START} ${t(UI.since)}`;

const CV = [
  { label: UI.education, entries: PI.education ?? [] },
  { label: UI.experience, entries: PI.experience ?? [] },
].filter((s) => s.entries.length > 0);
---

<div class="page">
  <header class="lead" data-quiet>
    <h1 class="title">{t(UI.sectionPeople)}</h1>
  </header>

  <article class="dossier">
    {/* 사진 — 조서를 읽는 내내 여백에 붙어 따라온다. */}
    <div class="portrait" data-quiet>
      {
        PI.photo ? (
          <DotPortrait
            src={PI.photo}
            alt={t(PI.name)}
            label={PI.id.replace(/-/g, '_')}
            width={3}
            height={4}
          />
        ) : null
      }
    </div>

    <div class="stream" data-quiet>
      {/* 이름 위에 `Principal Investigator` 가 눈썹줄로 서 있었다. 직함은
          직함 줄의 일이다 — 두 직함을 한 줄에 나란히 두면 눈썹줄이 사라지고
          읽히는 것은 오히려 늘어난다. */}
      <h2 class="name">{t(PI.name)}</h2>
      <p class="role">
        <span>{t(PI.role)}</span>
        <span>{t(UI.principalInvestigator)}</span>
      </p>
      {PI.affiliation ? <p class="affil">{t(PI.affiliation)}</p> : null}

      {/* 부임 시점과 메일 — 이름에 딸린 계측 한 줄. */}
      <p class="meta">
        {START ? <span>{SINCE}</span> : null}
        {
          PI.email ? (
            <a class="mail" href={`mailto:${PI.email}`}>
              {PI.email}
            </a>
          ) : null
        }
      </p>

      {
        CV.map((block) => (
          <section class="cvBlock">
            <h3 class="strip">
              <span class="stripLabel">{t(block.label)}</span>
              <span class="rule" aria-hidden="true" />
            </h3>

            <ol class="cv">
              {block.entries.map((e) => (
                <li>
                  <span class="period">{e.period}</span>
                  <div class="entry">
                    {/* 학위·직함과 기관을 줄표로 이어 붙였던 자리. 줄표는 두
                        사실을 한 줄로 눌러 어느 쪽이 무엇인지 흐렸다 — 학위는
                        본문 광도로 세우고 기관을 그 아래 캡션 광도로 내린다. */}
                    <p class="eRole">{t(e.role)}</p>
                    <p class="eOrg">{t(e.org)}</p>
                    {e.detail ? <p class="eDetail">{t(e.detail)}</p> : null}
                    {e.advisor ? (
                      <p class="ann eAdvisor">
                        {t(UI.advisor)}: {e.advisor}
                      </p>
                    ) : null}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </article>

  {/* 빈 명단 — 숫자를 감추지 않고, 그 자리에 모집 문안을 둔다. */}
  <section class="roster" data-quiet>
    <h2 class="strip">
      <span class="stripLabel">{t(UI.members)}</span>
      <span class="rule" aria-hidden="true"></span>
    </h2>

    {
      MEMBERS.length > 0 ? (
        /* 구성원 — 사진 · 이름 · 직함 · 관심 주제. 교수님 조서와 같은 어휘(점으로
           해상되는 사진, 본문색 이름, 한 단 내려앉은 직함, 모노 낱말 줄)를 작게 쓴다.
           카드 테두리·그림자는 없다 — 사진의 코너 틱이 이미 칸을 긋는다. */
        <ul class="people">
          {MEMBERS.map((m) => (
            <li class="person">
              {m.photo ? (
                <DotPortrait
                  src={m.photo}
                  alt={t(m.name)}
                  label={m.id.replace(/-/g, '_')}
                  width={3}
                  height={4}
                />
              ) : null}
              <div class="who">
                <p class="eRole">{t(m.name)}</p>
                <p class="eOrg">{t(m.role)}</p>
                {m.topics ? (
                  <ul class="topics">
                    {m.topics.map((k) => <li>{t(k)}</li>)}
                  </ul>
                ) : null}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="open">
          <p class="openText">{t(UI.membersEmpty)}</p>
          <p class="openText">{t(SITE.recruiting)}</p>
          <a class="reach" href={`mailto:${SITE.contact.email}`}>
            <span aria-hidden="true">▸</span> {t(UI.emailUs)}
          </a>
        </div>
      )
    }
  </section>

  {
    ALUMNI.length > 0 ? (
      <section class="roster" data-quiet>
        <h2 class="strip">
          <span class="stripLabel">{t(UI.alumni)}</span>
          <span class="rule" aria-hidden="true" />
        </h2>
        <ol class="cv">
          {ALUMNI.map((m) => (
            <li>
              <span class="period">{m.since ?? ''}</span>
              <div class="entry">
                <p class="eRole">{t(m.name)}</p>
                <p class="eDetail">{t(m.role)}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ) : null
  }
</div>

<script>
  import { mountAllDotPortraits } from '../lib/dotPortrait';
  mountAllDotPortraits();
</script>

<style>
  .page {
    display: grid;
    inline-size: min(100%, 64rem);
    padding-inline: var(--gutter);
  }

  /* 모노로 찍는 **읽는 값**. 라벨용 트래킹(0.12em)은 낱말을 흩뜨린다 —
     읽으라고 둔 줄에는 읽기용(0.04em)을 준다. */
  .ann {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
  }

  /* ---- 머리 ----------------------------------------------------------- */
  /*
   * 제목만. 눈썹줄도 제목 밑 실선도 없다 — 아래의 조서가 곧 본문이다.
   * 제목 옆에 인원수(`01`)가 서 있었다. 한 사람짜리 명단에서 그 수는 눈이
   * 이미 센 것을 다시 말할 뿐이고, 구성원이 늘면 아래 명단이 스스로 보여 준다.
   */
  .lead {
    padding-block: var(--space-9) var(--space-7);
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 5.5rem);
    font-weight: var(--w-thin);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--fg);
  }
  /* ---- 조서 ----------------------------------------------------------- */
  .dossier {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-6);
    padding-block-end: var(--space-8);
  }

  /*
   * 사진. 붙는 높이는 전역 `scroll-padding-block-start` 와 같은 값이어야
   * 앵커로 뛰어들어도 사진이 색인 줄에 겹치지 않는다.
   */
  .portrait {
    position: sticky;
    inset-block-start: var(--space-8);
    align-self: start;
    display: grid;
    justify-items: start;
  }
  /*
   * 사진은 `DotPortrait` 의 CSS 모듈이 190px 로 묶어 둔 것을 이 페이지에서만
   * 푼다. 홈에서는 도로 옆 요약이라 190px 이 맞지만, 여기서는 사진이 이 페이지의
   * 유일한 그림이고 왼쪽 기둥 전체를 쓴다. `:global()` 로 열되 `.portrait` 안으로
   * 한정해 다른 페이지에는 번지지 않는다.
   */
  .portrait :global([data-dot-wrap]) {
    max-inline-size: 100%;
  }

  /*
   * 부임 시점과 메일 — 이름에 딸린 계측 한 줄. 마디 사이에서만 줄이 바뀐다.
   * 트래킹은 라벨용(0.18em)이 아니라 읽는 값(0.04em)이다 — 읽으라고 둔 줄이다.
   */
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) 1.2em;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
    font-variant-numeric: tabular-nums;
  }
  .mail {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--track-mono-read);
    color: var(--fg);
    text-decoration: none;
    border-block-end: var(--hair) solid var(--line);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .mail:hover,
  .mail:focus-visible {
    border-block-end-color: var(--accent);
  }

  /* 손가락 과녁 44px. 여백으로 키우면 밑줄이 글자에서 떨어지므로 자리를
     차지하지 않는 겹침 상자로 키운다(모서리 색인·푸터와 같은 규칙). */
  @media (pointer: coarse) {
    .mail::after {
      content: '';
      position: absolute;
      inset: 50% 0 auto;
      block-size: var(--tap-min);
      inline-size: 100%;
      min-inline-size: var(--tap-min);
      translate: 0 -50%;
    }
  }

  .stream {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    min-inline-size: 0;
  }
  .name {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 1.2rem + 2.8vw, 3.4rem);
    font-weight: var(--w-light);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--fg);
  }
  /*
   * 직함 줄은 두 마디다(`Assistant Professor · Principal Investigator`).
   * 구분점은 **앞 마디에 붙는다** — 다음 마디 앞에 두면 줄이 바뀔 때 점이
   * 다음 줄 맨 앞에 떨어진다(논문 저자 줄과 같은 규칙).
   */
  .role {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0;
    font-size: var(--t-lg);
    line-height: var(--lh-2);
    color: var(--fg);
  }
  .role span:not(:last-child)::after {
    content: '·';
    padding-inline: 0.7em;
    color: var(--line-hot);
  }
  .affil {
    margin: 0;
    max-inline-size: 44ch;
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--fg-mute);
    text-wrap: pretty;
  }

  /* ---- 계측 스트립 ---------------------------------------------------- */
  /*
   * 라벨 → 점선. 선을 글자 뒤에서 시작하므로 라벨 뒤에 깔 불투명 면이
   * 필요 없다(면을 깔면 도로가 직각으로 잘린다).
   *
   * 선 끝에 항목 수(`03`·`02`·`00`)가 서 있었다. 바로 아래 목록이 그 수를
   * 이미 보여 주고, 빈 명단의 `00` 은 채울 것을 찾는 템플릿으로 읽혔다.
   */
  .strip {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.7em;
    inline-size: 100%;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: var(--w-mono);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--fg-mute);
    font-variant-numeric: tabular-nums;
  }
  .rule {
    flex: 1 1 auto;
    min-inline-size: 2rem;
    block-size: 0;
    border-block-start: var(--hair) dotted var(--scan);
  }
  /*
   * 모노 계측 라벨 안의 한글. 모노 글꼴에는 한글이 없어 본문 글꼴로 떨어지는데,
   * 라틴 대문자용으로 잡은 넓은 트래킹(0.18em)이 그대로 걸리면 글자가 흩어진다
   * (`연구실 구성원` 이 `연 구 실  구 성 원` 으로 읽혔다). global.css 의
   * `.mono:lang(ko)` 와 같은 값으로 되돌린다.
   */
  .strip:lang(ko) {
    letter-spacing: 0.04em;
  }

  .cvBlock {
    display: grid;
    gap: var(--space-3);
    inline-size: 100%;
    margin-block-start: var(--space-5);
  }

  /* ---- 이력 레일 ------------------------------------------------------- */
  .cv {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .cv li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .cv li + li {
    border-block-start: var(--hair) dotted var(--scan);
  }
  .period {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-2);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
  }
  .entry {
    display: grid;
    gap: var(--space-05);
    min-inline-size: 0;
  }
  /* 학위·직함이 항목의 머리다 — 본문 광도. */
  .eRole {
    margin: 0;
    font-size: var(--t-base);
    line-height: var(--lh-2);
    color: var(--fg);
    text-wrap: pretty;
  }
  /* 기관은 그 아래 한 단 내려앉는다. 학력 세 줄이 모두 같은 기관이라
     같은 줄에 이어 붙이면 어디까지가 학위인지 눈이 매번 다시 찾는다. */
  .eOrg {
    margin: 0;
    font-size: var(--t-base);
    line-height: var(--lh-2);
    color: var(--fg-mute);
    text-wrap: pretty;
  }
  /* 학위 → 기관은 광도로 갈리고, 기관 → 비고는 크기로 갈린다. */
  .eDetail {
    margin: var(--space-05) 0 0;
    max-inline-size: 52ch;
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--fg-mute);
    text-wrap: pretty;
  }
  .eAdvisor {
    color: var(--fg-dim);
  }

  /* ---- 명단 ----------------------------------------------------------- */
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 사진 폭(190px)에 글이 붙는 칸. 넓은 화면에서 셋이 한 줄, 좁으면 접힌다. */
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .person {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    min-inline-size: 0;
  }
  .who {
    display: grid;
    gap: var(--space-05);
    min-inline-size: 0;
  }
  /* 관심 주제 — 홈의 키워드 줄과 같은 규칙. 구분점은 앞 낱말에 붙는다. */
  .topics {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-05) 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
  }
  .topics li:not(:last-child)::after {
    content: '·';
    padding-inline: 0.7em;
    color: var(--line-hot);
  }
  .roster {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7) var(--space-8);
  }
  .open {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }
  .openText {
    margin: 0;
    max-inline-size: 54ch;
    font-size: var(--t-base);
    line-height: var(--lh-body);
    color: var(--fg-mute);
    text-wrap: pretty;
  }
  /* 버튼 어휘 — 사각 1px, 모노 대문자, ▸. hover 에서 배경이 아니라 테두리가 점등한다. */
  .reach {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-block-size: var(--tap-min);
    padding-inline: var(--space-2);
    border: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    font-weight: var(--w-mono-em);
    letter-spacing: var(--track-mono-read);
