---
/*
 * 연구 — 계측기가 큰 화면으로 서는 곳.
 *
 * 홈의 연구 구역은 **요약**이다(도로 옆 반 칸짜리 `compact` 계측기 넷). 여기가
 * 본론이라, 시뮬레이션이 본문 폭을 통째로 쓰고 `compact` 를 벗는다 — 구성 표기
 * (`22 VEH · RING 260 m …`)와 축 라벨이 돌아오고, 토글이 넉넉한 자리를 갖는다.
 * 계측의 예의는 설정을 밝히는 것이고, 그 자리가 여기다.
 *
 * 뼈대 — 홈과 다른 축으로 세운다.
 *   · 홈: 좌우 두 칸(글 | 계측기) + 화면 밖으로 잘린 번호.
 *   · 여기: **점선 스캔 라인이 막의 머리를 긋고**, 그 아래로 제목 → 키워드 →
 *     화면 폭 계측기가 한 줄로 내려간다. 막마다 한 화면을 쓴다.
 *
 * 한동안 그 선 왼쪽에 `01 / 04` 가 서 있었다. 제목 위의 작은 라벨은 그 자체로
 * 표식이고, 여기서는 알려 주는 것도 없었다 — 네 분야에는 순서가 없어서 번호가
 * 정보를 나르지 않는다. 지웠다. 읽을 번호는 여는 화면의 색인에 그대로 있다.
 * 거기서는 번호가 **어디로 뛰는가**를 가리키므로 정보다.
 *
 * 여는 화면은 **네 분야의 색인**이다. 이 페이지는 넷을 차례로 보는 곳이라, 어디에
 * 무엇이 있는지 먼저 보이고 눌러서 건너뛸 수 있어야 한다(전부 `#id` 앵커 — JS 없음).
 *
 * 연구분야에는 설명문을 두지 않는다(교수님 결정). 제목 + 키워드 한 줄 + 도는 모델이
 * 설명을 대신한다. 여기 있는 글은 전부 `src/data/research.ts` 의 것이다.
 */
import TrafficSim from '../components/TrafficSim';
import { RESEARCH } from '../data/research';
import { pick, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = (v: Parameters<typeof pick>[0]) => pick(v, lang);
---

<div class="page">
  {/* 여는 화면 — 제목과 색인. 눈썹줄도, 제목 밑의 실선도 없다. */}
  <div class="lead" data-quiet>
    <h1 class="title">{t(UI.sectionResearch)}</h1>

    <nav class="index" aria-label={pick(UI.sectionResearch, lang)}>
      <ol class="indexList">
        {RESEARCH.map((a) => (
          <li>
            <a href={`#area-${a.id}`}>
              <span class="iNo">{a.index}</span>
              <span class="iName">{t(a.title)}</span>
              <span class="iGo" aria-hidden="true">▸</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  {
    RESEARCH.map((a) => (
      <article class="act" id={`area-${a.id}`}>
        <div class="head" data-quiet>
          <h2 class="name">{t(a.title)}</h2>

          {/* 키워드는 칩이 아니라 줄바꿈되는 한 줄이다 — 테두리를 넷씩 그리면 카드가 된다. */}
          <ul class="keys">
            {a.keywords.map((k) => (
              <li>{k}</li>
            ))}
          </ul>
        </div>

        {/*
          계측기. 홈과 달리 `compact` 가 아니다 — 구성 표기와 축 라벨이 붙는다.
          화면에 들어올 때만 하이드레이트하고, 훅이 화면 밖에서 rAF 를 멈춘다
          (보이는 시뮬 하나만 돈다).
        */}
        <TrafficSim client:visible scenario={a.scenario} lang={lang} />
      </article>
    ))
  }
</div>

<style>
  /*
   * 본문 기둥은 **왼쪽에 붙는다.** 가운데 정렬하면 넓은 화면에서 도로가 좌우로
   * 똑같이 갈라져 배경이 액자가 된다 — 홈처럼 한쪽으로 몰아야 도로가 이어진다.
   * 계측기가 폭을 먹는 페이지라 다른 페이지보다 기둥이 넓다(78rem).
   */
  .page {
    display: grid;
    inline-size: min(100%, 78rem);
    padding-inline: var(--gutter);
  }

  .keys {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
  }

  /* ---- 여는 화면 ------------------------------------------------------ */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
    align-items: end;
    gap: var(--space-7);
    /* 아래 여백이 막의 위 여백(80px)보다 좁다 — 선은 **뒤에 오는 것에 붙는다.** */
    padding-block: var(--space-9) var(--space-6);
  }

  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 5.5rem);
    font-weight: var(--w-thin);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--fg);
  }

  .indexList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .indexList li + li {
    border-block-start: var(--hair) dotted var(--scan);
  }
  .indexList a {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 1rem;
    gap: var(--space-2);
    align-items: center;
    /* 손가락 과녁. 여백이 아니라 최소 높이로 잡아 기준선이 밀리지 않게 한다. */
    min-block-size: var(--tap-min);
    padding-block: var(--space-1);
    color: var(--fg-mute);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .indexList a:hover,
  .indexList a:focus-visible {
    color: var(--fg);
  }
  .iNo {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-mono);
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
  }
  .iName {
    font-size: var(--t-sm);
    line-height: var(--lh-2);
    text-wrap: pretty;
  }
  .iGo {
    justify-self: end;
    color: var(--line-hot);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .indexList a:hover .iGo,
  .indexList a:focus-visible .iGo {
    color: var(--accent);
  }

  /* ---- 막 ------------------------------------------------------------- */
  /*
   * 앵커로 뛰어들 때 막의 위끝이 화면 꼭대기에 닿게 한다. 전역
   * `scroll-padding-block-start`(80px)와 이 값이 상쇄되어, 스트립이 정확히
   * 막의 위 패딩(80px) 만큼 내려온 자리에 선다 — 고정 색인 한 줄 바로 아래다.
   */
  /*
   * 막의 머리를 긋는 것은 점선 한 줄이다 — 섹션 구분선은 실선이 아니라 스캔
   * 라인이다. 선이 곧 "여기서 다음 분야가 시작한다"이고, 그 위의 여백(80px)이
   * 아래 여백보다 커서 제목이 선에 딸린 것으로 읽힌다.
   */
  .act {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-9);
    border-block-start: var(--hair) dotted var(--scan);
    scroll-margin-block-start: calc(var(--space-8) * -1);
  }

  /* 제목 → 키워드. 흐름에 맡기면 둘이 붙어 한 덩어리로 읽힌다. */
  .head {
    display: grid;
    gap: var(--space-3);
  }

  .name {
    margin: 0;
    max-inline-size: 20ch;
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 1.1rem + 2.7vw, 3.4rem);
    font-weight: var(--w-light);
    line-height: 1.04;
    letter-spacing: -0.032em;
    text-wrap: balance;
    color: var(--fg);
  }

  .keys {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* 열 간격이 곧 구분점의 자리다 — 점은 그 한가운데에 앉는다(아래 `li + li::before`). */
    gap: var(--space-1) 1.4em;
    overflow: clip;
  }
  .keys li {
    position: relative;
    white-space: nowrap;
  }
  /* 구분점은 **다음 항목의 앞 여백에 절대 배치**하고, 목록 상자가 넘친 것을 잘라 낸다
     (`overflow: clip`). 그러면 줄이 바뀔 때 첫 항목의 점은 상자 밖(왼쪽)으로 나가 보이지
     않고, 줄 끝에는 점이 애초에 없다. 앞 항목에 `::after` 로 붙였을 때는 줄 끝에 점이
     홀로 남았고(`Lead drop 0.0 km/h ·` 뒤에 줄바꿈), `li + li::before` 로 흘려 두었을
     때는 다음 줄 맨 앞에 떨어졌다 — 둘 다 스크린샷에서 잡혔다. */
  .keys li + li::before {
    content: '·';
    position: absolute;
    inset-inline-start: -0.7em;
    transform: translateX(-50%);
    color: var(--line-hot);
  }

  /* ---- 좁은 화면 ------------------------------------------------------ */
  @media (max-width: 62rem) {
    .lead {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--space-5);
      /* 위쪽 120px — 고정 색인이 좁은 화면에서 두세 줄로 접히면 바닥이 100px 까지 내려온다. 80px 이면 제목 위에 얹혔다(실측). */
      padding-block: var(--space-9) var(--space-6);
    }
    .act {
      gap: var(--space-4);
      padding-block: var(--space-6) var(--space-8);
    }
  }
</style>
