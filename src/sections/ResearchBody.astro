---
/*
 * 연구 — 계측기가 큰 화면으로 서는 곳.
 *
 * 홈의 연구 구역은 **요약**이다(도로 옆 반 칸짜리 `compact` 계측기 넷). 여기가
 * 본론이라, 시뮬레이션이 본문 폭을 통째로 쓰고 `compact` 를 벗는다 — 구성 표기
 * (`22 VEH · RING 260 m …`)와 축 라벨이 돌아오고, 토글이 넉넉한 자리를 갖는다.
 * 계측의 예의는 설정을 밝히는 것이고, 그 자리가 여기다.
 *
 * 뼈대 — 홈과 다른 축으로 세운다.
 *   · 홈: 좌우 두 칸(글 | 계측기) + 화면 밖으로 잘린 번호.
 *   · 여기: **가로로 눕힌 채널 스트립**(`01 / 04 ····························`)이
 *     막의 머리를 긋고, 그 아래로 제목 → 키워드 → 화면 폭 계측기가 한 줄로 내려간다.
 *     막마다 한 화면을 쓰고, 스트립이 다음 막의 시작을 알린다.
 *
 * 여는 화면은 **네 분야의 색인**이다. 이 페이지는 넷을 차례로 보는 곳이라, 어디에
 * 무엇이 있는지 먼저 보이고 눌러서 건너뛸 수 있어야 한다(전부 `#id` 앵커 — JS 없음).
 *
 * 연구분야에는 설명문을 두지 않는다(교수님 결정). 제목 + 키워드 한 줄 + 도는 모델이
 * 설명을 대신한다. 여기 있는 글은 전부 `src/data/research.ts` 의 것이다.
 */
import TrafficSim from '../components/TrafficSim';
import { RESEARCH } from '../data/research';
import { pick, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = (v: Parameters<typeof pick>[0]) => pick(v, lang);

/** 분야 셈 — `01 / 04`. 배열이 늘면 분모도 따라 는다. */
const TOTAL = String(RESEARCH.length).padStart(2, '0');
---

<div class="page">
  {/* 여는 화면 — 제목과 색인. 눈썹줄도, 제목 밑의 실선도 없다. */}
  <div class="lead" data-quiet>
    <h1 class="title">{t(UI.sectionResearch)}</h1>

    <nav class="index" aria-label={pick(UI.sectionResearch, lang)}>
      <ol class="indexList">
        {RESEARCH.map((a) => (
          <li>
            <a href={`#area-${a.id}`}>
              <span class="iNo">{a.index}</span>
              <span class="iName">{t(a.title)}</span>
              <span class="iGo" aria-hidden="true">▸</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  {
    RESEARCH.map((a) => (
      <article class="act" id={`area-${a.id}`}>
        <div class="head" data-quiet>
          {/* 채널 스트립 — 번호가 왼쪽에 서고 점선이 화면 끝까지 간다.
              라벨을 선 위에 얹으면 뒤에 깔 불투명 면이 필요해진다(도로를 직각으로
              자른다). 선을 번호 **뒤에서** 시작해 그 문제를 아예 없앤다. */}
          <p class="strip">
            <span class="no">{a.index}</span>
            <span class="of">/ {TOTAL}</span>
            <span class="rule" aria-hidden="true" />
          </p>

          <h2 class="name">{t(a.title)}</h2>

          {/* 키워드는 칩이 아니라 줄바꿈되는 한 줄이다 — 테두리를 넷씩 그리면 카드가 된다. */}
          <ul class="keys">
            {a.keywords.map((k) => (
              <li>{k}</li>
            ))}
          </ul>
        </div>

        {/*
          계측기. 홈과 달리 `compact` 가 아니다 — 구성 표기와 축 라벨이 붙는다.
          화면에 들어올 때만 하이드레이트하고, 훅이 화면 밖에서 rAF 를 멈춘다
          (보이는 시뮬 하나만 돈다).
        */}
        <TrafficSim client:visible scenario={a.scenario} lang={lang} />
      </article>
    ))
  }
</div>

<style>
  /*
   * 본문 기둥은 **왼쪽에 붙는다.** 가운데 정렬하면 넓은 화면에서 도로가 좌우로
   * 똑같이 갈라져 배경이 액자가 된다 — 홈처럼 한쪽으로 몰아야 도로가 이어진다.
   * 계측기가 폭을 먹는 페이지라 다른 페이지보다 기둥이 넓다(78rem).
   */
  .page {
    display: grid;
    inline-size: min(100%, 78rem);
    padding-inline: var(--gutter);
  }

  .ann,
  .strip,
  .keys {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-mono);
    letter-spacing: var(--track-mono-read);
    color: var(--fg-mute);
  }

  /* ---- 여는 화면 ------------------------------------------------------ */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
    align-items: end;
    gap: var(--space-7);
    padding-block: var(--space-9) var(--space-8);
  }

  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 5.5rem);
    font-weight: var(--w-thin);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--fg);
  }

  .indexList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .indexList li + li {
    border-block-start: var(--hair) dotted var(--scan);
  }
  .indexList a {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 1rem;
    gap: var(--space-2);
    align-items: center;
    /* 손가락 과녁. 여백이 아니라 최소 높이로 잡아 기준선이 밀리지 않게 한다. */
    min-block-size: var(--tap-min);
    padding-block: var(--space-1);
    color: var(--fg-mute);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .indexList a:hover,
  .indexList a:focus-visible {
    color: var(--fg);
  }
  .iNo {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-mono);
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
  }
  .iName {
    font-size: var(--t-sm);
    line-height: var(--lh-2);
    text-wrap: pretty;
  }
  .iGo {
    justify-self: end;
    color: var(--line-hot);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .indexList a:hover .iGo,
  .indexList a:focus-visible .iGo {
    color: var(--accent);
  }

  /* ---- 막 ------------------------------------------------------------- */
  /*
   * 앵커로 뛰어들 때 막의 위끝이 화면 꼭대기에 닿게 한다. 전역
   * `scroll-padding-block-start`(80px)와 이 값이 상쇄되어, 스트립이 정확히
   * 막의 위 패딩(80px) 만큼 내려온 자리에 선다 — 고정 색인 한 줄 바로 아래다.
   */
  .act {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-9);
    scroll-margin-block-start: calc(var(--space-8) * -1);
  }

  /* 스트립 → 제목 → 키워드. 흐름에 맡기면 셋이 붙어 한 덩어리로 읽힌다. */
  .head {
    display: grid;
    gap: var(--space-3);
  }

  .strip {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.7em;
    font-variant-numeric: tabular-nums;
  }
  .no {
    font-size: var(--t-mono-sm);
    color: var(--fg);
  }
  .of {
    color: var(--fg-dim);
  }
  /* 점선이 막의 머리를 끝까지 긋는다 — 섹션 구분선은 실선이 아니라 스캔 라인이다. */
  .rule {
    flex: 1 1 auto;
    min-inline-size: 2rem;
    block-size: 0;
    margin-inline-start: 0.6em;
    border-block-start: var(--hair) dotted var(--scan);
  }

  .name {
    margin: 0;
    max-inline-size: 20ch;
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 1.1rem + 2.7vw, 3.4rem);
    font-weight: var(--w-light);
    line-height: 1.04;
    letter-spacing: -0.032em;
    text-wrap: balance;
    color: var(--fg);
  }

  .keys {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* 열 간격 0 — 낱말 사이를 벌리는 일은 구분점이 자기 좌우 여백으로 한다. */
    gap: var(--space-1) 0;
  }
  .keys li {
    white-space: nowrap;
  }
  /* 구분점은 앞 낱말에 붙는다 — `li + li::before` 로 두면 줄이 바뀔 때
     점이 다음 줄 맨 앞에 떨어진다. */
  .keys li:not(:last-child)::after {
    content: '·';
    padding-inline: 0.7em;
    color: var(--line-hot);
  }

  /* ---- 좁은 화면 ------------------------------------------------------ */
  @media (max-width: 62rem) {
    .lead {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--space-5);
      /* 위쪽 120px — 고정 색인이 좁은 화면에서 두세 줄로 접히면 바닥이 100px 까지 내려온다. 80px 이면 제목 위에 얹혔다(실측). */
      padding-block: var(--space-9) var(--space-6);
    }
    .act {
      gap: var(--space-4);
      padding-block: var(--space-6) var(--space-8);
    }
  }
</style>
