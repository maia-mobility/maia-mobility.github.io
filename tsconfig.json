/*
 * `.astro/types.d.ts` 는 `astro sync` 가 만든다 — CSS 모듈(`*.module.css`)의 타입과
 * `import.meta.env` 가 거기서 온다. gitignore 대상이라 **새로 클론한 환경에는 없다.**
 * 그래서 `npm run typecheck` 가 `astro sync` 를 먼저 돌린다(package.json).
 * 이걸 빼면 로컬에서는 통과하는데 CI 에서만 15개쯤 터진다 — 실제로 그랬다.
 */
{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}