{
  "name": "maia-lab-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro sync && tsc --noEmit",
    "audit": "node scripts/audit.mjs",
    "verify": "npm run typecheck && npm run lint:design && npm run build && npm run audit && npm run stage:check",
    "lint:design": "node scripts/lint-design.mjs",
    "og": "astro build && (astro preview --port 4331 & sleep 3; node scripts/make-og.mjs http://localhost:4331/; kill %1)",
    "sim:check": "node scripts/sim-check.mjs",
    "sim:trace": "node scripts/platoon-trace.mjs",
    "hero:check": "node scripts/hero-check.mjs",
    "stage:check": "node scripts/stage-check.mjs",
    "portrait:check": "node scripts/portrait-check.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "puppeteer-core": "^25.10.0",
    "typescript": "^7.0.2"
  },
  "description": "명지대학교 MAIA 연구실 (Mobility, AI & Autonomous System) 홈페이지",
  "private": true
}
